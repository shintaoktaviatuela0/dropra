# ─────────────────────────────────────────────────────────────
# Dropra environment configuration
# Copy this file to .env for local development.
# On Railway, set these as service variables instead.
# NEVER commit real credentials.
# ─────────────────────────────────────────────────────────────

# Runtime environment: development | production
NODE_ENV=development

# Port the server listens on. On Railway this is provided automatically.
# Only used as a fallback for local development.
PORT=3000

# Root directory for ALL persistent data (database, uploads, thumbnails...).
# On Railway, attach a Volume and mount it here.
DATA_DIR=./data

# Public base URL of your instance (used to build shareable links).
# Example: https://file.example.com  — no trailing slash.
# Leave empty to auto-detect from the request (works behind Railway, Render,
# Heroku, nginx/Caddy and other reverse proxies via X-Forwarded-Host).
PUBLIC_URL=

# Honour X-Forwarded-* headers from a reverse proxy. Set to false only if the
# app is exposed directly to the internet without a proxy in front.
TRUST_PROXY=true

# Administrator account. Created automatically on first boot.
# The password is hashed with Argon2id and never stored in plaintext.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Secret used to sign session cookies. If left empty, a strong secret is
# generated and persisted under DATA_DIR/system on first boot.
SESSION_SECRET=

# Maximum upload size in bytes (default 2 GB).
MAX_UPLOAD_SIZE=2147483648
